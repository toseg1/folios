# Copy to .env (gitignored) and fill in real values. Never commit .env.

# --- Docker stack ---

# Host ports. Change these if 5432 / 3000 are already taken by something
# else on your machine.
POSTGRES_PORT=5432
METABASE_PORT=3000

# Bootstrap superuser, used only by docker-entrypoint-initdb.d on first
# container init.
POSTGRES_SUPERUSER=postgres
POSTGRES_SUPERUSER_PASSWORD=change-me

# Read/write role used by the folios CLI and loader.
FOLIOS_LOADER_PASSWORD=change-me

# Read-only role a Metabase data-source connection uses against marts.*
# (yours, or the optional bundled one — see metabase/compose.yml).
METABASE_RO_PASSWORD=change-me

# Only needed if you use the optional bundled Metabase container
# (`make metabase-up`). Not required if you point your own existing
# Metabase at this Postgres instead.
METABASE_APP_PASSWORD=change-me

# --- folios dashboard-init (build-plan step 19) ---

# Only needed to run `folios dashboard-init`. Create the key in Metabase
# under Admin settings -> Authentication -> API keys.
METABASE_URL=http://localhost:3000
METABASE_API_KEY=change-me

# The name of the Metabase database connection pointing at this
# Postgres (Admin settings -> Databases) — whatever you named it when
# you set it up by hand per build-plan step 13.
METABASE_DATABASE_NAME=folios
